# ==========================================
# 9D CONTROL KAS - Environment Configuration
# ==========================================
# Copy this file to ".env" and fill in your own secure values before running.
# NEVER commit the real ".env" file to version control.

# Server
PORT=3000
NODE_ENV=production

# Security secrets - MUST be changed to long random strings in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
COOKIE_SECRET=change_this_to_another_long_random_secret_string

# Session / token lifetime (in hours)
SESSION_HOURS=12

# Initial admin account (used only the first time the database is seeded)
# Change immediately after first login via Settings.
ADMIN_ABSEN=ADMIN
ADMIN_NAME=Wali Kelas Admin
ADMIN_PASSWORD=change_this_admin_password

# Default demo member password (for seed/demo data only - change in production)
DEMO_MEMBER_PASSWORD=kas9d2026

# Class / app defaults (can be changed later from Settings)
CLASS_NAME=9D
APP_NAME=9D CONTROL KAS
WEEKLY_CASH_AMOUNT=10000
PERIOD_START_DATE=2026-07-13

# Rate limiting
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# File upload limits
MAX_UPLOAD_MB=5

